{
  "name": "@worldkit/world-canvas",
  "version": "0.0.1",
  "description": "Painterly interactive world canvas: verdant tile maps, autonomous sprite characters, day/night lighting, and dialogue boxes.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "imports": {
    "#lib/*": "./src/lib/*.ts",
    "#components/*": "./src/components/*.tsx"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./demo": "./src/demo/index.ts",
    "./demo/*": "./src/demo/*.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint ."
  },
  "dependencies": {
    "@worldkit/grid": "workspace:*",
    "@worldkit/lighting": "workspace:*",
    "@worldkit/pathfinding": "workspace:*",
    "@worldkit/sprite-actor": "workspace:*",
    "@worldkit/tilemap": "workspace:*",
    "@worldkit/world": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "storybook": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "^19.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
