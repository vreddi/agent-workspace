    "radix-ui": "^1.4.2",
    "shadcn": "^3.5.0",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.3.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.9.2"
