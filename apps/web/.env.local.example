# Copy to apps/web/.env.local and fill in values.
#   cp apps/web/.env.local.example apps/web/.env.local
#
# Single env file for local dev (web + Convex CLI).
# Never commit apps/web/.env.local.

# --- Clerk — https://dashboard.clerk.com/last-active?path=api-keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_

# Issuer URL from Clerk → JWT templates → "convex" (e.g. https://foo.clerk.accounts.dev)
# Sync to Convex: pnpm convex:env:sync
CLERK_JWT_ISSUER_DOMAIN=

# --- Convex (pnpm dev:web writes CONVEX_* here automatically)
# Set VITE_CONVEX_URL to the same value as CONVEX_URL after first convex dev run.
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=
VITE_CONVEX_URL=

# Skip T3 env validation in CI
# SKIP_ENV_VALIDATION=1
