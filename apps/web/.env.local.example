# Copy to apps/web/.env.local and fill in values.
#   cp apps/web/.env.local.example apps/web/.env.local
#
# This is the single env file for local dev (web + Convex CLI).
# Never commit apps/web/.env.local.

# --- WorkOS (Staging) — https://dashboard.workos.com
# Redirects: http://localhost:3000/api/auth/callback
# Sign-in:    http://localhost:3000/api/auth/sign-in
# Sign-out:   http://localhost:3000/
WORKOS_CLIENT_ID=client_
WORKOS_API_KEY=sk_test_
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
WORKOS_COOKIE_PASSWORD=

# --- Convex (pnpm dev:web writes CONVEX_* here automatically)
# Set VITE_CONVEX_URL to the same value as CONVEX_URL after first convex dev run.
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=
VITE_CONVEX_URL=

# Optional WorkOS cookie tuning
# WORKOS_COOKIE_MAX_AGE=34560000
# WORKOS_COOKIE_NAME=wos-session
# WORKOS_COOKIE_DOMAIN=
# WORKOS_COOKIE_SAMESITE=lax

# Skip T3 env validation in CI
# SKIP_ENV_VALIDATION=1
