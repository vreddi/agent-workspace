# WorkOS AuthKit — copy to apps/web/.env and fill from https://dashboard.workos.com
# Generate cookie password: openssl rand -base64 24
#
# Dashboard → Redirects (https://dashboard.workos.com/redirects):
#   Redirect URI:     http://localhost:3000/api/auth/callback
#   Sign-in endpoint: http://localhost:3000/api/auth/sign-in
#   Sign-out redirect: http://localhost:3000/

WORKOS_CLIENT_ID=client_
WORKOS_API_KEY=sk_test_
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
WORKOS_COOKIE_PASSWORD=

# Convex (from repo root: pnpm exec convex dev --once → copy CONVEX_URL here as VITE_)
VITE_CONVEX_URL=http://127.0.0.1:3210

# Skip T3 env validation (CI/docker builds without secrets)
# SKIP_ENV_VALIDATION=1

# Optional
# WORKOS_COOKIE_MAX_AGE=34560000
# WORKOS_COOKIE_NAME=wos-session
# WORKOS_COOKIE_DOMAIN=
# WORKOS_COOKIE_SAMESITE=lax
