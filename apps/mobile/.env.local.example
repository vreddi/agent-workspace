# Copy to .env.local (or add the real file to the canonical store as
# ~/.config/agent-workspace/mobile/.env.local — scripts/link-worktree-env.sh
# symlinks it here; the store filename must stay ".env.local" because
# Expo's dev server recognizes env files by basename through symlinks).
#
# PUBLIC values only. Every EXPO_PUBLIC_* variable is inlined into the
# shipped JS bundle and readable by anyone with the app. Never put secret
# keys here (sk_*, whsec_*, deploy keys) — the app has no server side to
# hide them in. Secrets live in web/root env files and on Convex/EAS.
#
# Same underlying services as apps/web: copy the values from
# VITE_CONVEX_URL and VITE_CLERK_PUBLISHABLE_KEY.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
